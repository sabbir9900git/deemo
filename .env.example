# ============================================================================
# MARS EXPLORER — Environment Configuration (.env.example)
# Copy this file to .env (root), backend/.env, or frontend/.env.local
# No paid API keys, cloud servers, or external databases are required!
# ============================================================================

# Backend FastAPI Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///../database/mars_explorer.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# NASA Mars Trek Official WMTS Endpoint (Public, Keyless)
NASA_MARS_TREK_WMTS_BASE=https://trek.nasa.gov/tiles/Mars/EQ
ENABLE_TILE_CACHE=true

# Optional External AI Provider (Leave blank to use the built-in Grounded Local Scientific Assistant)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Frontend Next.js Configuration
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
NEXT_PUBLIC_MARS_TREK_WMTS_URL=https://trek.nasa.gov/tiles/Mars/EQ
